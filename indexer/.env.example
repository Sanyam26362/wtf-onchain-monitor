# Sepolia / indexer configuration
CHAIN_ID=11155111
RPC_URL=https://sepolia.infura.io/v3/your_infura_key

# MonthlyPayroll Contract Configuration
PAYROLL_CONTRACT_ADDRESS=0x430e558d403E3668C3A2E3435ff2Fd6a01Eb7F3A
PAYROLL_STREAM_ID=monthly_payroll

# WTF ERC-20 Token Configuration (token-agnostic)
# Configured for newly deployed WTF Token contract on Sepolia
TOKEN_ADDRESS=0x378AFb93CaDd39AFF154704d2D90Af8c401137E7
TOKEN_ABI_PATH=./abi/erc20.json
TOKEN_START_BLOCK=11717931
TOKEN_STREAM_ID=erc20_transfers_0x378afb93cadd39aff154704d2d90af8c401137e7

# General Indexer Configuration
START_BLOCK=11732519
BACKFILL_TO_BLOCK=11751150
CONFIRMATION_DEPTH=5
CONFIRMATIONS=5
BLOCK_BATCH_SIZE=50
INDEXER_BATCH_SIZE=50
POLLING_INTERVAL=12s
LIVE_POLL_INTERVAL=5s
LIVE_MONITOR_ENABLED=false
DEPLOYMENT_ENVIRONMENT=development
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-patient-base-aypeaol4-pooler.c-5.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Dedicated PostgreSQL schema owned by the indexer. Keeps indexer tables
# (employers, employees, ...) separate from the application tables of the
# same name in "public". Defaults to "indexer" if unset.
DB_SCHEMA=indexer

# RPC Retry & Rate Limit Configuration
RPC_MAX_RETRIES=5
RPC_INITIAL_BACKOFF=1s
RPC_MAX_BACKOFF=30s
RPC_BACKOFF_FACTOR=2.0

# Reconciliation Configuration
RECONCILIATION_ENABLED=false
RECONCILIATION_BLOCK_WINDOW=500
RECONCILIATION_INTERVAL=30s
RECONCILIATION_STREAM_ID=reconciliation_payroll_funding

# REST API Configuration
API_HOST=0.0.0.0
API_PORT=8080
CORS_ALLOWED_ORIGINS=*
EXPLORER_TX_URL_TEMPLATE=https://sepolia.etherscan.io/tx/%s
OPERATOR_API_KEY=your_operator_secret_api_key_here
